# virtual environment and Python caches
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# editors and operating systems
.idea/
.vscode/
*.swp
*~
.DS_Store

# secrets and local settings; keys are only ever typed into the chat page and sent in request headers
.env
