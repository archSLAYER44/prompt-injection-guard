# round run trees (scripts/round6_setup.py); each is a copy of the working tree
rounds/

# runtime guard log and server logs written by the dashboard, the chat sites and the Streamlit pages
logs/
nohup.out

# the champion copies build their own embedding cache when the gate scores them; never commit it
backup_round*/data/cache/
